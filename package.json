{
  "name": "zuji-history-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:history": "vite --mode history --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "privacy:audit": "node scripts/privacy-audit/scan-public.mjs",
    "test": "node --experimental-strip-types --test tests/motion-director.test.mjs tests/timeline-model.test.mjs tests/entry-motion.test.mjs tests/meteor-model.test.mjs tests/stage04a-exhibition.test.mjs tests/stage04a-route.test.mjs tests/stage04b5-public-reading.test.mjs tests/stage06b-intro-policy.test.mjs tests/stage06c-music.test.mjs tests/stage07-privacy-boundary.test.mjs tests/stage07b-music-release.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:stage04a-test": "npm run typecheck && vite build --mode stage04a-test",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:stage04a-test": "vite preview --outDir output/stage04a/builds/nonempty-test-20261016 --host 127.0.0.1 --port 4186 --strictPort",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4174 --strictPort",
    "test:browser": "node scripts/browser-check.mjs",
    "test:stage04a:browser": "node scripts/stage04a-browser-acceptance.mjs",
    "test:motion": "node --experimental-strip-types --test tests/motion-director.test.mjs",
    "test:stage04b3": "node --experimental-strip-types --test tests/stage04b3-navigation.test.mjs tests/stage04b3-release.test.mjs",
    "test:stage04b3:browser": "node scripts/stage04b3/browser-acceptance.mjs",
    "test:stage04b4:intro": "node scripts/stage04b4/intro-acceptance.mjs",
    "test:stage04b4:team": "node scripts/stage04b4/team-acceptance.mjs",
    "test:stage04b4:home": "node scripts/stage04b4/home-acceptance.mjs",
    "test:stage04b4:dev-story": "node scripts/stage04b4/dev-story-acceptance.mjs",
    "test:stage04b4:release": "node scripts/stage04b4/prepare-release.mjs",
    "record:stage04b4:intro-comparison": "node scripts/stage04b4/intro-comparison.mjs",
    "test:cinematic": "node scripts/cinematic-check.mjs",
    "record:cinematic": "node scripts/record-cinematic.mjs",
    "test:meteors": "node scripts/meteors-check.mjs",
    "record:task00_9": "node scripts/task00_9-record.mjs",
    "content:import": "C:/Py/python.exe -X utf8 scripts/stage01b/import.py",
    "content:inspect": "node scripts/stage01b/inspect.mjs",
    "validate:staging": "node scripts/stage01b/inspect.mjs --validate",
    "test:stage01b": "npm run content:import && C:/Py/python.exe -X utf8 -m unittest discover -s tests -p test_stage01b.py && node --test tests/stage01b-content.test.mjs",
    "test:stage01c": "node --test tests/stage01c-projection.test.mjs",
    "test:stage02": "node --experimental-strip-types --test tests/stage02-state.test.mjs tests/stage02-media.test.mjs tests/stage02-map.test.mjs",
    "test:stage02:browser": "node scripts/stage02-browser-check.mjs",
    "record:stage02": "node scripts/stage02-record.mjs",
    "dev:team": "vite --mode team --host 127.0.0.1 --port 5176 --strictPort",
    "build:history": "npm run typecheck && vite build --mode history",
    "preview:history": "vite preview --outDir output/stage04b1/builds/history-internal --host 127.0.0.1 --port 4175 --strictPort",
    "team:import": "C:/Py/python.exe -X utf8 scripts/stage04b1/import.py",
    "test:stage04b1": "node --test tests/stage04b1-team-preview.test.mjs",
    "test:stage04b1:browser": "node scripts/stage04b1-browser-acceptance.mjs",
    "test:stage04b1:review": "node scripts/stage04b1-review-check.mjs",
    "team:verify": "C:/Py/python.exe -X utf8 scripts/stage04b1/verify.py",
    "test:stage04b5:browser": "node scripts/stage04b5/full-acceptance.mjs",
    "test:stage04b5:visual": "node scripts/stage04b5/visual-acceptance.mjs",
    "release:stage04b5": "node scripts/stage04b5/release-verify.mjs",
    "test:stage06c": "node --experimental-strip-types --test tests/stage06c-music.test.mjs"

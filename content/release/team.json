    { "id": "public-note-a1", "memberId": "a1", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "把史料、结构与阅读路径组织成一部作品。", "contribution": "负责项目策划、内容统筹与公开版叙事结构。", "status": "approved", "scope": "public", "confirmedByMember": true },
    { "id": "public-note-a2", "memberId": "a2", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "让复杂的史料可以被清楚地阅读。", "contribution": "负责前端工程、交互实现与可复现构建。", "status": "approved", "scope": "public", "confirmedByMember": true },
    { "id": "public-note-a3", "memberId": "a3", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "编辑也是一种细致的历史阅读。", "contribution": "负责历史文献摘录、文字编辑与阅读层次整理。", "status": "approved", "scope": "public", "confirmedByMember": true },
    { "id": "public-note-a4", "memberId": "a4", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "图像需要来源，也需要边界。", "contribution": "负责历史图像目录、来源说明与展示边界整理。", "status": "approved", "scope": "public", "confirmedByMember": true },
    { "id": "public-note-a5", "memberId": "a5", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "从校史材料中辨认时间与制度。", "contribution": "负责早期校史材料检索、比对与专题梳理。", "status": "approved", "scope": "public", "confirmedByMember": true },
    { "id": "public-note-a6", "memberId": "a6", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "文献的细节让时代获得质感。", "contribution": "负责抗战时期文献检索、编年与证据关联。", "status": "approved", "scope": "public", "confirmedByMember": true },

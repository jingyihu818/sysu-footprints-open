    { "id": "public-note-a8", "memberId": "a8", "originalVersion": "stage07-anonymized-public-v1", "displayText": "公开版以匿名岗位卡片呈现团队协作，保留工作方法与作品结构，不公开个人身份材料。", "excerpt": "党史叙事必须保留来源与不确定性。", "contribution": "负责党史脉络梳理、来源核对与叙事边界标注。", "status": "approved", "scope": "public", "confirmedByMember": true },
